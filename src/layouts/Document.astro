---
import profile from '../data/profile.json';
import ProfileLinks from '../components/ProfileLinks.astro';
import { localPath } from '../lib/paths';
import '../styles/site.css';
import '../styles/study-controls.css';
interface Props { title: string; description?: string; canonicalPath?: string; article?: Record<string, unknown>; noindex?: boolean; home?: boolean; }
const { title, description = 'Quantum algorithms, error correction, and machine learning. Research by Dantong Li at Yale University.', canonicalPath, article, noindex = import.meta.env.WEBSITE_INDEXABLE !== 'true', home = false } = Astro.props;
const canonical = new URL(canonicalPath ? localPath(canonicalPath) : Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#deded7" />
    <title>{title === profile.name ? profile.name : `${title} · ${profile.name}`}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={localPath('favicon.svg')} />
    <link rel="preload" href={localPath('fonts/Archivo-Latin.woff')} as="font" type="font/woff" crossorigin />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(localPath('images/portrait.jpg'), Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <slot name="head" />
    {article && <script type="application/ld+json" set:html={JSON.stringify(article).replaceAll('<', '\u003c')} />}
  </head>
  <body class:list={{'is-home':home}}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-wordmark" href={localPath()} aria-label="Dantong Li home">{profile.name}</a>
      <span class="site-context">Computer Science / Yale</span>
      <nav aria-label="Main navigation">
        <a href={localPath('publication/')} aria-current={Astro.url.pathname.endsWith('/publication/') ? 'page' : undefined}>All work <sup>06</sup></a>
        <a href={localPath('about/')} aria-current={Astro.url.pathname.endsWith('/about/') ? 'page' : undefined}>About</a>
        <a href={localPath('about/#profiles')} aria-label="Profiles and contact">Profiles</a>
      </nav>
    </header>
    <main id="main" class="site-main"><slot /></main>
    <footer class="site-footer" id="contact">
      <a class="footer-email" href={`mailto:${profile.email}`}>Let’s talk.<span>{profile.email} ↗</span></a>
      <ProfileLinks class="footer-links" />
      <span class="footer-signature">Dantong Li / {new Date().getFullYear()}</span>
    </footer>
  </body>
</html>
