---
import { getCollection } from 'astro:content';
import Document from '../../layouts/Document.astro';
import exhibition from '../../data/exhibition.json';
import { localPath } from '../../lib/paths';
import '../../styles/paper.css';
const publications = await getCollection('publications');
const works = exhibition.map(display => {
  const publication = publications.find(p => p.id === display.id);
  if (!publication) throw new Error(`Missing publication: ${display.id}`);
  return { ...display, publication };
});
const payload = works.map(work => ({ ...work, publication: undefined, title: work.publication.data.title, status: work.publication.data.status, page: localPath(`publication/${work.id}/`), source: work.publication.data.publicationUrl, code: work.publication.data.codeUrl, bibtex: localPath(`publication/${work.id}/cite.bib`) }));
---
<Document title="Research" description="Six studies in quantum compilation, algorithms, error correction and measurement." canonicalPath="publication/">
  <section class="research-overview" aria-label="An open field of six research studies" data-research-overview>
    <div class="research-overview__meta"><span>All work</span><span>2023—2026</span></div>
    <div class="research-overview__canvas" data-research-scene aria-hidden="true"></div>
    <div class="research-overview__labels" aria-label="Choose a study">
      {works.map((work,i)=><a class={`research-label research-label--${i+1}`} href={localPath(`publication/${work.id}/`)} id={work.id} data-research-label={i} aria-label={`${work.publication.data.title}. ${work.year}. Open study.`} style={`--work-accent:${work.accent}`}><span class="research-label__number">{work.index}</span><span><strong>{work.label}</strong><small>{work.year} / {work.publication.data.status === 'Preprint' ? 'Preprint' : work.publication.data.venue.includes('Letters') ? 'PRL' : work.publication.data.venue.includes('Workshop') ? 'Workshop' : 'IEEE QCE'}</small></span><span class="research-label__arrow" aria-hidden="true">↗</span></a>)}
    </div>
    <div class="research-current" data-research-current>
      <div data-research-intro><span class="paper-section-label">Quantum computing</span><h1>Research</h1><p>Six works in one space.</p></div>
      <div data-research-detail hidden><button type="button" data-research-clear aria-label="Return to the full research overview">All 06 ↖</button><h2 data-research-headline></h2><div class="research-current__links"><a data-research-page href={localPath('publication/')}>Explore study ↗</a><a data-research-source href={works[0].publication.data.publicationUrl}>Paper ↗</a></div></div>
    </div>
    <div class="research-overview__controls"><div class="research-overview__turn"><div class="research-viewpoint" data-research-orbit role="slider" tabindex="0" aria-label="Turn research view" aria-description="Drag left or right. Or use the arrow keys." aria-valuemin="-35" aria-valuemax="35" aria-valuenow="0" aria-valuetext="Centred" aria-orientation="horizontal" aria-keyshortcuts="ArrowLeft ArrowRight ArrowUp ArrowDown Home End"><span aria-hidden="true">◌</span>Turn view</div><button type="button" class="research-reset" data-research-reset aria-label="Reset research view to centre">Reset view</button></div><span>Drag to turn · choose a work to open it</span><a href={localPath()}>Return to the studio ↗</a></div>
    <script type="application/json" data-research-data set:html={JSON.stringify(payload).replaceAll('<','\\u003c')} />
  </section>
  <script is:inline defer src={localPath('exhibition/compiler.js')}></script>
  <script is:inline defer src={localPath('exhibition/source-data.js')}></script>
  <script is:inline defer src={localPath('exhibition/scene.js')}></script>
  <script is:inline defer src={localPath('exhibition/index.js')}></script>
</Document>
