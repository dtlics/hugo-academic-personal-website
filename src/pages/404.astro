---
import Document from '../layouts/Document.astro';
import { localPath } from '../lib/paths';
---
<Document title="Page not found" noindex={true}>
  <section class="lost-page"><span class="mono">404 / A different route</span><h1>Out of<br />the frame.</h1><p>This page could not be found.</p><a href={localPath()}>Enter the studio ↗</a><a href={localPath('publication/')}>Find a study ↗</a></section>
</Document>
<style>.lost-page{max-width:1250px;margin:0 auto;padding:70px var(--gutter) 120px}.lost-page h1{font-size:clamp(64px,12vw,170px);line-height:.86;letter-spacing:-.07em;margin:50px 0 35px}.lost-page p{font-size:20px;margin-bottom:22px}.lost-page>a{display:inline-flex;min-height:44px;align-items:center;margin-right:30px;text-decoration:underline;font-size:14px}@media(max-width:560px){.lost-page{padding-block:45px 70px}.lost-page h1{font-size:20vw}}</style>
