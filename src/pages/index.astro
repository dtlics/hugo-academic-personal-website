---
import { getCollection } from 'astro:content';
import Document from '../layouts/Document.astro';
import profile from '../data/profile.json';
import exhibition from '../data/exhibition.json';
import { localPath } from '../lib/paths';
import '../styles/exhibition.css';
const papers = await getCollection('publications');
const studies = exhibition.map(study=>({...study,paper:papers.find(p=>p.id===study.id)!}));
---
<Document title={profile.name} home>
  <div class="exhibition" data-exhibition data-count={studies.length}>
    <div class="exhibition-track" id="home">
      {studies.map((_,i)=><span id={`work-${i+1}`} class="exhibition-anchor" style={`--anchor:${i}`} aria-hidden="true" />)}
      <div class="exhibition-stage">
        <div class="exhibition-world">
          <div class="exhibition-scene" data-scene role="group" aria-label="Six research studies share one space. Scroll between them, then use each study’s control." />
          <div class="exhibition-photo-position" data-photo>
            <div class="exhibition-photo">
              <svg viewBox="0 0 1000 1000" role="img" aria-labelledby="portrait-title">
                <title id="portrait-title">Dantong Li in a racing suit, holding a helmet beside a race car</title>
                <defs><clipPath id="portrait-cut"><path d="M120 0H1000V1000H0V760H65V140H120Z" /></clipPath></defs>
                <g clip-path="url(#portrait-cut)"><image href={localPath('images/portrait.jpg')} width="1000" height="1000" /><path fill="#39313e" d="M938 0H1000V1000H938Z M0 760H245V1000H0Z" /></g>
              </svg>
              <span>Dantong Li / 00</span>
            </div>
          </div>
          <div class="exhibition-name" data-name>
            <span class="mono">Quantum computing</span>
            <h1 aria-label="Dantong Li">Dantong<br /><span>Li</span></h1>
          </div>
          <div class="exhibition-profile" id="about">
            <p class="desktop-role">Computer Science<br />Ph.D. Candidate<br />Yale University</p>
            <p class="phone-role">Computer Science Ph.D. Candidate<br />Yale University</p>
            <p class="practice">Algorithms and compilation.<br />Error correction and mitigation.<br />Machine learning.</p>
          </div>
          <div class="exhibition-stories" id="featured" aria-label="Research highlights">
            {studies.map((study,i)=><article class="exhibition-story" data-story={i} aria-hidden="true" inert>
              <div class="study-identity"><span class="study-number" aria-hidden="true">{study.index}</span><div><p class="study-title">{study.label}</p><p class="mono">{study.category} / {study.year}</p></div></div>
              <h2>{study.headline.map(line=><span>{line}</span>)}</h2>
              <p class="study-note">{study.note}</p>
              <div class="study-links"><a href={localPath(`publication/${study.id}/`)}>Explore study ↗</a><a href={study.paper.data.publicationUrl}>{study.paper.data.status==='Preprint'?'Preprint':'Paper'} ↗</a></div>
            </article>)}
          </div>
          <a class="exhibition-end-link" href={localPath('about/')} data-end-link hidden>Behind the work.<span>About me ↗</span></a>
        </div>
        <div class="exhibition-progress"><span data-current-label>00 / Identity and practice</span><span data-scroll-cue>Scroll to begin the research ↓</span><a href={localPath('publication/')}>All work ↗</a></div>
      </div>
    </div>
    <div class="exhibition-static" aria-label="Research">
      {studies.map(study=><article><span class="mono">{study.index} / {study.category}</span><h2><a href={localPath(`publication/${study.id}/`)}>{study.headline.join(' ')}</a></h2><p>{study.note}</p><a href={study.paper.data.publicationUrl}>{study.paper.data.citationLabel} ↗</a></article>)}
    </div>
  </div>
  <script is:inline defer src={localPath('exhibition/compiler.js')} />
  <script is:inline defer src={localPath('exhibition/source-data.js')} />
  <script is:inline defer src={localPath('exhibition/scene.js')} />
  <script is:inline defer src={localPath('exhibition/controls.js')} />
  <script is:inline defer src={localPath('exhibition/home.js')} />
</Document>
