---
import Document from '../layouts/Document.astro';
import profile from '../data/profile.json';
import ProfileLinks from '../components/ProfileLinks.astro';
import { localPath } from '../lib/paths';
const motto = ['忘', '剑', '得', '神', '兵'];
---
<Document title="About" description="Dantong Li is a Computer Science Ph.D. Candidate at Yale University, working on quantum computing and machine learning." canonicalPath="about/">
  <Fragment slot="head">
    <link rel="preload" href={localPath('fonts/ZhiMangXing-Motto.woff2')} as="font" type="font/woff2" crossorigin />
  </Fragment>
  <div class="about-page" data-variant="cut">
    <section class="about-opening" aria-labelledby="about-title">
      <p class="about-kicker">About / {profile.name}</p>
      <h1 id="about-title">I work on<br />quantum<br />computing.</h1>
      <div class="about-portrait">
        <img src={localPath('images/portrait.jpg')} width="800" height="800" alt="Dantong Li in a racing suit, holding a helmet beside a race car" decoding="async" />
        <figure class="motto" tabindex="0">
          <p class="motto__text" lang="zh-Hans">{motto.map((character, i) => <span style={`--i:${i}`}>{character}</span>)}</p>
          <figcaption class="motto__translation">Forget the sword, gain the divine weapon.<span class="motto__seal" aria-hidden="true"></span></figcaption>
        </figure>
      </div>
      <div class="about-introduction" id="profiles">
        <p class="about-role">{profile.role}<br />{profile.institution}</p>
        <p>My advisor is <a href={profile.advisorUrl}>{profile.advisor}<span aria-hidden="true"> ↗</span></a>. My research includes quantum algorithms and compilation, quantum error correction and mitigation, and machine learning.</p>
        <ProfileLinks includeEmail />
        <a class="about-research-link" href={localPath('publication/')}>Explore my research<span aria-hidden="true"> ↗</span></a>
      </div>
    </section>
    <section class="about-section" aria-labelledby="education-title">
      <h2 id="education-title">Education</h2>
      <ol class="about-ledger">
        <li>
          <span class="about-ledger__years">2022–{profile.expectedGraduation}</span>
          <div><p class="about-ledger__place">{profile.institution}</p><p>Ph.D. in Computer Science, expected {profile.expectedGraduation}<br />{profile.masters}</p></div>
        </li>
        <li>
          <span class="about-ledger__years">2018–2022</span>
          <div><p class="about-ledger__place">The University of Hong Kong</p><p>B.Eng. in Computer Science, first-class honours</p></div>
        </li>
      </ol>
    </section>
    <section class="about-section" id="outside-research" aria-labelledby="outside-title">
      <h2 id="outside-title">Outside research</h2>
      <p class="about-lead">I like my music experimental and my cars on a racetrack. Away from research, I also play League of Legends and turn engineering ideas into working projects with AI, including tools for quant trading.</p>
    </section>
  </div>
</Document>
<style>
  /* Zhi Mang Xing (SIL OFL 1.1), reduced to the five characters of the motto. */
  @font-face{font-family:'Motto Brush';src:url('/fonts/ZhiMangXing-Motto.woff2') format('woff2');font-display:block;unicode-range:U+5175,U+5251,U+5F97,U+5FD8,U+795E}
  /* One type scale, ratio 3 : 2 from the 16px body: 16 · 24 · 36 · 54 · 81.
     Labels use the site's 11px mono. The display line moves between 54 and 81
     with the viewport; nothing else changes size. */
  .about-page{--s-label:11px;--s-body:16px;--s-lead:24px;--s-display:clamp(54px,5.625vw,81px);--ink-deep:#2b2430;padding:0 var(--gutter);color:var(--ink)}
  :where(.about-page) :where(h1,h2,p,figure,ol){margin:0}
  .about-page a{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px}
  .about-page p a span,.about-research-link span{display:inline-block;text-decoration:none;margin-left:.25em}
  .about-kicker,.about-section>h2,.about-ledger__years,.motto__translation{font:var(--s-label)/1.5 RFMono,monospace;letter-spacing:.02em;font-weight:400}

  /* Opening: words on the left half, the portrait on the right half. */
  .about-opening{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;align-items:start;padding-block:40px 112px}
  .about-kicker{grid-column:1/7;grid-row:1;margin-bottom:32px}
  .about-opening h1{grid-column:1/7;grid-row:2;font-size:var(--s-display);font-weight:480;line-height:.94;letter-spacing:-.06em}
  .about-introduction{grid-column:1/7;grid-row:3;align-self:end;margin-top:48px;font-size:var(--s-body);line-height:1.6}
  .about-introduction>p{max-width:31em}
  .about-introduction>*+*{margin-top:16px}
  .about-role{font-size:var(--s-lead);line-height:1.3;letter-spacing:-.025em;margin-bottom:24px;text-wrap:balance}
  .about-introduction :global(.profile-links){column-gap:20px;font-size:var(--s-body);margin-top:20px}
  .about-research-link{display:inline-block;padding-block:10px}

  /* The portrait keeps the home page's single cut. Here the cut runs deeper,
     to hold the motto, as the cut on the home page holds the name. */
  .about-portrait{grid-column:7/-1;grid-row:2/4;position:relative;container-type:inline-size;--cut-w:21%;--cut-h:84%}
  .about-portrait>img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:cover;filter:saturate(.84);clip-path:polygon(var(--cut-w) 0,100% 0,100% 100%,0 100%,0 var(--cut-h),var(--cut-w) var(--cut-h))}
  .about-portrait:after{content:'';position:absolute;inset:0;background:var(--ink);mix-blend-mode:lighten;clip-path:polygon(var(--cut-w) 0,100% 0,100% 100%,0 100%,0 var(--cut-h),var(--cut-w) var(--cut-h));pointer-events:none}

  .motto{position:absolute;left:0;top:0;width:var(--cut-w);height:var(--cut-h);display:flex;justify-content:center;outline:none;cursor:default}
  .motto__text{writing-mode:vertical-rl;font-family:'Motto Brush',serif;font-size:16.2cqw;line-height:1;letter-spacing:-.03em;color:var(--ink-deep);white-space:nowrap}
  .motto__text span{display:inline-block}
  /* The translation sits where a calligrapher signs: a small column to the
     left of the text, closed by a seal. It appears on hover or focus. */
  .motto__translation{position:absolute;right:calc(100% + 10px);top:22%;writing-mode:vertical-rl;white-space:nowrap;opacity:0;transform:translateY(-6px);transition:opacity .4s ease,transform .4s ease;pointer-events:none}
  .motto:hover .motto__translation,.motto:focus-visible .motto__translation{opacity:1;transform:none}
  .motto:focus-visible{outline:2px solid var(--ink);outline-offset:6px}
  .motto__seal{display:inline-block;inline-size:13px;block-size:13px;margin-inline-start:12px;vertical-align:middle;background:var(--clay);box-shadow:inset 0 0 0 2px var(--clay),inset 0 0 0 3px var(--ground)}

  /* Below the opening every section has the same form: a rule, a label on the
     left half, the text on the right half, aligned with the portrait. */
  .about-section{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;border-top:1px solid var(--rule);padding-block:24px 96px}
  .about-section>h2{grid-column:1/7}
  .about-section>:not(h2){grid-column:7/-1}
  .about-lead{font-size:var(--s-lead);line-height:1.4;letter-spacing:-.025em;max-width:30em;text-wrap:pretty}
  .about-ledger{list-style:none;padding:0;display:grid;gap:40px}
  .about-ledger li{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,5fr);column-gap:24px;align-items:baseline}
  .about-ledger__place{font-size:var(--s-lead);line-height:1.3;letter-spacing:-.025em;margin-bottom:8px}
  .about-ledger li p:not(.about-ledger__place){font-size:var(--s-body);line-height:1.6}

  @media(prefers-reduced-motion:no-preference){
    .motto__text span{animation:motto-write .62s cubic-bezier(.45,.05,.3,1) both;animation-delay:calc(.25s + var(--i) * .24s)}
  }
  @property --write{syntax:'<percentage>';inherits:false;initial-value:115%}
  @keyframes motto-write{from{--write:-15%}to{--write:115%}}
  .motto__text span{-webkit-mask-image:linear-gradient(to bottom,#000 var(--write),transparent calc(var(--write) + 15%));mask-image:linear-gradient(to bottom,#000 var(--write),transparent calc(var(--write) + 15%))}

  @media(hover:none){.motto__translation{opacity:1;transform:none}}
  @media(prefers-reduced-motion:reduce){.motto__translation{transition:opacity .2s linear;transform:none}}
  /* Narrower screens set the translation as one line under the photo. */
  @media(max-width:1099px){.motto__translation{right:auto;left:0;top:calc(100cqw + 14px);writing-mode:horizontal-tb}.about-portrait{margin-bottom:36px}}
  @media(max-width:900px){
    .about-section{grid-template-columns:minmax(0,1fr);row-gap:24px}
    .about-section>h2,.about-section>:not(h2){grid-column:1}
  }
  @media(max-width:700px){
    .about-opening{grid-template-columns:minmax(0,1fr);padding-block:24px 72px}
    .about-kicker,.about-opening h1,.about-introduction,.about-portrait{grid-column:1;grid-row:auto}
    .about-opening h1{margin-bottom:32px}
    .about-introduction{margin-top:24px;align-self:start}
    .about-section{padding-block:20px 64px}
    .about-ledger li{grid-template-columns:minmax(0,1fr);row-gap:4px}
  }
</style>
