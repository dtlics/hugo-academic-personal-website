---
import Document from '../layouts/Document.astro';
import profile from '../data/profile.json';
import ProfileLinks from '../components/ProfileLinks.astro';
import { localPath } from '../lib/paths';
const programming = profile.skills['Programming and quantum software'];
const machineLearning = profile.skills['Machine learning'];
const statistics = profile.skills.Statistics;
---
<Document title="About" description="Dantong Li is a Computer Science Ph.D. Candidate at Yale University, working on quantum computing and machine learning." canonicalPath="about/">
  <div class="about-page">
    <section class="about-opening" aria-labelledby="about-title">
      <p class="about-label">About / {profile.name}</p>
      <h1 id="about-title"><span>I work on</span><span>quantum</span><span>computing.</span></h1>
      <figure class="about-portrait">
        <img src={localPath('images/portrait.jpg')} width="800" height="800" alt="Dantong Li in a racing suit, holding a helmet beside a race car" decoding="async" />
      </figure>
      <div class="about-introduction" id="profiles">
        <p class="about-role">{profile.role}<br />{profile.institution}</p>
        <ProfileLinks includeEmail />
        <p>My advisor is <a href={profile.advisorUrl}>{profile.advisor}<span aria-hidden="true"> ↗</span></a>. I expect to graduate in {profile.expectedGraduation}.</p>
        <p>My research includes quantum algorithms and compilation, quantum error correction and mitigation, and machine learning.</p>
        <a class="about-research-link" href={localPath('publication/')}>Explore my research <span aria-hidden="true">↗</span></a>
      </div>
    </section>
    <section class="about-outside" id="outside-research" aria-labelledby="outside-title">
      <h2 id="outside-title">Outside research</h2>
      <p>I like my music experimental and my cars on a racetrack. Away from research, I also play League of Legends and turn engineering ideas into working projects with AI, including tools for quant trading.</p>
    </section>
    <section class="about-education" aria-labelledby="education-title">
      <h2 id="education-title">Education</h2>
      <div class="education-yale">
        <p class="education-statement">I joined {profile.institution} in 2022. I expect to complete my Ph.D. in Computer Science in {profile.expectedGraduation}.</p>
        <p class="education-masters">{profile.masters}</p>
      </div>
      <div class="education-hku">
        <p class="education-statement">Before Yale, I studied Computer Science at The University of Hong Kong from 2018 to 2022. I graduated with a B.Eng. and first-class honours.</p>
      </div>
    </section>
    <section class="about-skills" aria-labelledby="skills-title">
      <h2 id="skills-title">Skills</h2>
      <div class="skill-programming"><h3>Programming and quantum software</h3><p>{programming.join(', ')}</p></div>
      <div class="skill-learning"><h3>Machine learning</h3><p>{machineLearning.join(', ')}</p></div>
      <div class="skill-statistics"><h3>Statistics</h3><p>{statistics[0]}<br />{statistics[1]}</p></div>
    </section>
  </div>
</Document>
<style>
  .about-page{max-width:1440px;margin-inline:auto;padding:clamp(24px,4vw,72px);color:var(--ink,#39313e)}
  .about-page :where(h1,h2,h3,p,figure){margin:0}
  .about-page a{color:inherit;text-decoration-thickness:1px;text-underline-offset:5px}
  .about-label{font:12px/1.5 RFMono,monospace;letter-spacing:.015em}
  .about-opening{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;align-items:start;padding-block:24px 96px}
  .about-opening>.about-label{grid-column:1/7;grid-row:1;margin-bottom:29px}
  .about-opening h1{grid-column:1/8;grid-row:2;font-size:clamp(54px,7.4vw,106px);font-weight:480;line-height:.94;letter-spacing:-.065em;text-wrap:initial}
  .about-opening h1 span{display:block}
  .about-opening .about-portrait{grid-column:8/-1;grid-row:2/4;align-self:start;position:relative;isolation:isolate;margin-top:80px;padding:0 24px 26px 0}
  .about-portrait:before{content:'';position:absolute;z-index:-1;inset:13% 0 0 10%;background:var(--ink,#39313e);clip-path:polygon(0 0,100% 0,100% 100%,0 100%,0 76%,16% 76%,16% 0)}
  .about-portrait img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;object-position:50% 50%;clip-path:polygon(12% 0,100% 0,100% 100%,0 100%,0 14%,12% 14%)}
  .about-introduction{grid-column:2/7;grid-row:3;max-width:42ch;margin-top:45px;font-size:17px;line-height:1.65;scroll-margin-top:30px}
  .about-introduction :global(.profile-links){margin-bottom:20px;max-width:350px}
  .about-introduction .about-role{font-size:clamp(19px,1.7vw,24px);line-height:1.3;letter-spacing:-.025em;margin-bottom:26px}
  .about-introduction p+p{margin-top:20px}
  .about-research-link{display:inline-flex;align-items:center;gap:12px;min-height:44px;margin-top:18px;font-size:15px}
  .about-page h2{font-size:clamp(24px,2.5vw,36px);font-weight:480;line-height:1.1;letter-spacing:-.04em}
  .about-outside{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:24px;padding-block:24px 78px;scroll-margin-top:30px}
  .about-outside h2{grid-column:1/5}
  .about-outside>p{grid-column:6/-1;max-width:42ch;font-size:clamp(23px,2.35vw,32px);line-height:1.4;letter-spacing:-.025em;text-wrap:pretty}
  .about-education,.about-skills{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:0 24px;align-items:start;padding-block:72px}
  .about-education h2{grid-column:1/5}
  .education-yale{grid-column:6/-1}
  .education-hku{grid-column:2/9;margin-top:92px}
  .education-statement{font-size:clamp(27px,3.2vw,44px);font-weight:440;line-height:1.18;letter-spacing:-.04em;text-wrap:pretty}
  .education-masters{max-width:34ch;margin-top:16px!important;font-size:16px;line-height:1.6}
  .about-skills{padding-block:72px 112px}
  .about-skills h2{grid-column:1/5}
  .skill-programming{grid-column:6/-1}
  .skill-learning{grid-column:2/7;margin-top:88px}
  .skill-statistics{grid-column:8/-1;margin-top:130px}
  .about-skills h3{font-size:15px;line-height:1.4;font-weight:500;margin-bottom:19px}
  .about-skills p{font-size:clamp(25px,2.55vw,36px);line-height:1.25;font-weight:440;letter-spacing:-.035em;text-wrap:pretty}
  .skill-statistics p{font-weight:500}
  @media(max-width:950px){
    .about-opening{column-gap:18px}
    .about-opening h1{font-size:clamp(54px,7.8vw,76px)}
    .about-opening .about-portrait{grid-column:8/-1;margin-top:48px;padding:0 14px 18px 0}
    .about-introduction{grid-column:1/7;font-size:16px}
    .skill-learning{grid-column:1/7}
    .skill-statistics{grid-column:8/-1}
  }
  @media(max-width:700px){
    .about-page{padding-inline:24px}
    .about-opening{grid-template-columns:repeat(6,minmax(0,1fr));gap:0 16px;padding-block:13px 54px}
    .about-opening>.about-label{grid-column:1/-1;margin-bottom:24px}
    .about-opening h1{grid-column:1/-1;grid-row:2;font-size:clamp(49px,12vw,76px)}
    .about-opening .about-portrait{grid-column:2/-1;grid-row:3;margin-top:35px;max-width:420px;justify-self:end}
    .about-introduction{grid-column:1/-1;grid-row:4;margin-top:35px;font-size:17px;max-width:44ch}
    .about-introduction .about-role{font-size:23px;margin-bottom:23px}
    .about-outside{grid-template-columns:repeat(6,minmax(0,1fr));gap:24px 16px;padding-block:16px 38px}
    .about-outside h2,.about-outside>p{grid-column:1/-1}
    .about-outside>p{font-size:24px;line-height:1.45}
    .about-education,.about-skills{grid-template-columns:repeat(6,minmax(0,1fr));gap:0 16px;padding-block:38px}
    .about-education h2,.about-skills h2{grid-column:1/-1;margin-bottom:39px}
    .education-yale{grid-column:2/-1}
    .education-hku{grid-column:1/-1;margin-top:65px}
    .education-statement{font-size:clamp(26px,5.8vw,35px)}
    .education-masters{font-size:15px}
    .skill-programming{grid-column:1/-1}
    .skill-learning{grid-column:2/-1;margin-top:43px}
    .skill-statistics{grid-column:1/-1;margin-top:43px}
    .about-skills p{font-size:clamp(25px,5.7vw,32px)}
    .about-skills{padding-bottom:66px}
  }
  @media(max-width:360px){
    .about-page{padding-inline:18px}
    .about-opening h1{font-size:44px}
    .about-opening{column-gap:10px}
    .about-opening .about-portrait{grid-column:1/-1;width:94%}
    .about-introduction .about-role{font-size:21px}
    .education-yale{grid-column:1/-1}
    .about-skills p{font-size:25px}
  }
</style>
