---
import Document from '../layouts/Document.astro';
import profile from '../data/profile.json';
import ProfileLinks from '../components/ProfileLinks.astro';
import { localPath } from '../lib/paths';
// The motto's sword, drawn for this site: black iron, a fret-framed window
// in the guard, a fang-like horn and a long slotted handle. Its red qi is
// painted in public/images/motto-qi-*.webp (behind and in front of it). As
// the sword goes, its iron turns to the red glow of motto-sword-ember.svg.
import sword from '../assets/motto-sword.svg?raw';
import ember from '../assets/motto-sword-ember.svg?raw';
const motto = ['忘', '剑', '得', '神', '兵'];
// Both schools use the same four parts: years, school, degree, one note.
const education = [
  { years: `2022–${profile.expectedGraduation}`, school: profile.institution, degree: `Ph.D. in Computer Science, expected ${profile.expectedGraduation}`, note: profile.masters },
  { years: '2018–2022', school: 'The University of Hong Kong', degree: 'B.Eng. in Computer Science', note: 'First-class honours' },
];
// A detail line may break only after its first comma, so narrow screens
// never leave one word ("2028", "Kong") alone on a line.
const halves = (line: string) => { const [head, ...rest] = line.split(', '); return rest.length ? [head, rest.join(', ')] : [head]; };
---
<Document title="About" description="Dantong Li is a Computer Science Ph.D. Candidate at Yale University, working on quantum computing and machine learning." canonicalPath="about/">
  <Fragment slot="head">
    <link rel="preload" href={localPath('fonts/ZhiMangXing-Motto.woff2')} as="font" type="font/woff2" crossorigin />
    <script is:inline>if(matchMedia('(prefers-reduced-motion: no-preference)').matches)document.documentElement.classList.add('motto-motion')</script>
  </Fragment>
  <div class="about-page">
    <div class="about-spread">
      <p class="about-kicker">About / {profile.name}</p>
      <h1 id="about-title">I work on<br />quantum<br />computing.</h1>
      <div class="about-introduction" id="profiles">
        <p class="about-role">{profile.role}<br />{profile.institution}</p>
        <p>My advisor is <a href={profile.advisorUrl}>{profile.advisor}<span aria-hidden="true"> ↗</span></a>. My research includes quantum algorithms and compilation, quantum error correction and mitigation, and machine learning.</p>
        <ProfileLinks includeEmail />
        <a class="about-research-link" href={localPath('publication/')}>Explore my research<span aria-hidden="true"> ↗</span></a>
      </div>
      <div class="about-rail">
        <div class="about-panel">
          <div class="about-portrait">
            <img src={localPath('images/portrait.jpg')} width="800" height="800" alt="Dantong Li in a racing suit, holding a helmet beside a race car" decoding="async" />
          </div>
          <div class="about-track">
            <figure class="motto" data-motto>
              <span class="motto__phrase" lang="zh-Hans">{motto.join('')}</span>
              <p class="motto__text" lang="zh-Hans" aria-hidden="true">{motto.map(character => <span class="motto__cell" data-c={character}><span class="motto__ink">{character}</span></span>)}</p>
              <span class="motto__blade" aria-hidden="true"><span><i class="motto__qi motto__qi--back"></i><Fragment set:html={sword} /><Fragment set:html={ember} /><i class="motto__qi motto__qi--front"></i></span></span>
              <figcaption class="motto__translation"><span>Forget the sword; </span><span>let true steel speak.</span></figcaption>
            </figure>
          </div>
        </div>
      </div>
      <section class="about-section" aria-labelledby="education-title">
        <h2 id="education-title">Education</h2>
        <ol class="about-ledger">
          {education.map(entry => <li>
            <span class="about-ledger__years">{entry.years}</span>
            <div><p class="about-ledger__place">{entry.school}</p><p>{[entry.degree, entry.note].map(line => <span class="about-ledger__line">{halves(line).map((half, i) => <>{i > 0 && ', '}<span class="about-ledger__half">{half}</span></>)}</span>)}</p></div>
          </li>)}
        </ol>
      </section>
      <section class="about-section" id="outside-research" aria-labelledby="outside-title">
        <h2 id="outside-title">Outside research</h2>
        <p class="about-lead">I like my music experimental and my cars on a racetrack. Away from research, I also play League of Legends and turn engineering ideas into working projects with AI, including tools for quant trading.</p>
      </section>
    </div>
  </div>
  <script is:inline>
    // The portrait and the motto stay in view while the words scroll past.
    // The reader's scroll moves a sword down through the motto. The sword is
    // tied to the scroll: it moves when the page moves, by no more than the
    // page moves, and stops when the page stops. Each character opens in the
    // wake of its point, the English follows each half of the line, and past
    // 兵 the iron fades into its red qi. Scrolling back brings the sword back
    // up and closes the motto again.
    (() => {
      const root = document.documentElement, motto = document.querySelector('[data-motto]');
      if (!motto) return;
      const rail = document.querySelector('.about-rail'), panel = rail.firstElementChild, track = motto.parentElement;
      const spread = rail.parentElement, page = spread.parentElement;
      const inks = [...motto.querySelectorAll('.motto__ink')], blade = motto.querySelector('.motto__blade > span');
      const iron = blade.querySelector('.sword'), glow = blade.querySelector('.sword-ember'), qi = [...blade.querySelectorAll('.motto__qi')];
      const [first, second] = motto.querySelectorAll('.motto__translation > span');
      const calm = matchMedia('(prefers-reduced-motion: reduce)');
      const clamp = v => Math.min(1, Math.max(0, v));
      const ramp = (v, from, to) => clamp((v - from) / (to - from));
      // The point of the sword, in em below the head of the column. It waits
      // in the head of 忘 (START), cuts down through the five characters, and
      // a little below 兵 (END) the sword has gone. The sword is LENGTH em
      // long, from the end of its handle to its point.
      const START = .1, END = 5.6, LENGTH = 3.3, SLIT = .03, WAKE = .6;
      let em = 16, range = 0, hold = 0, timed = false, played = false, armed = false, drawn = NaN, raf = 0, refresh = () => {};
      // The small viewport height (100svh) does not change while a phone's
      // address bar comes and goes, so the held part does not jump.
      const probe = document.createElement('div');
      probe.style.cssText = 'position:fixed;top:0;left:0;width:0;height:100vh;height:100svh;visibility:hidden;pointer-events:none';
      document.body.append(probe);

      // The held part (portrait and motto; the motto alone on a phone) is
      // held where it first stands, or higher when the screen is short. The
      // cut runs from the top of the page over most of the time it is held,
      // and may go on after the held part moves on while the foot of the
      // column is below the middle of the screen; it always ends before the
      // head of the column leaves the screen, and never past the end of the
      // page. Over that scroll the point moves at most as far as the page.
      // Where the page is too short for that, the whole spread holds still
      // for a while when its foot reaches the foot of the screen (or before
      // the held part moves on, if that comes first): the sword alone moves
      // then, for as much scroll as it still needs, up to half a screen. The
      // CSS decides which layout is in use: on a phone the rail is not a box
      // of its own, and the column there is short enough for its page.
      const measure = () => {
        const small = getComputedStyle(rail).display === 'contents', held = small ? motto : panel, box = small ? track : rail;
        (small ? panel : motto).style.top = '';
        // Measure the page as it lies, without the hold; the space the hold
        // adds below the spread stays, so the scroll does not move.
        page.classList.remove('is-held');
        em = parseFloat(getComputedStyle(motto).fontSize);
        drawn = NaN;
        const style = getComputedStyle(box), rect = box.getBoundingClientRect();
        const top = rect.top + scrollY + parseFloat(style.paddingTop) + (small ? parseFloat(getComputedStyle(motto).marginTop) : 0);
        // The held height counts the end of the translation and its seal.
        const bottom = rect.bottom + scrollY - parseFloat(style.paddingBottom), height = Math.max(held.offsetHeight, second.getBoundingClientRect().bottom - held.getBoundingClientRect().top);
        const view = probe.offsetHeight || innerHeight, stick = Math.max(16, Math.min(top, view - height - 32));
        held.style.top = `${stick}px`;
        const unpin = bottom - height - stick;
        const base = Math.min(root.scrollHeight - hold - innerHeight - 24, Math.max(unpin * .85, unpin + stick + height - view * .55), unpin + stick - 16);
        const sheet = spread.getBoundingClientRect(), from = Math.min(sheet.bottom + scrollY - view, unpin), need = (END - START) * em - base;
        hold = armed && !small && !calm.matches && from > 0 && from < base && need > 0 ? Math.round(Math.min(need, view / 2)) : 0;
        page.style.setProperty('--hold', `${hold}px`);
        if (hold) {
          page.style.setProperty('--hold-top', `${Math.round(sheet.top + scrollY - from)}px`);
          page.classList.add('is-held');
        }
        range = base + hold;
        timed = range < 160;
      };
      measure();
      addEventListener('resize', () => { measure(); refresh(); });
      if ('ResizeObserver' in window) new ResizeObserver(() => { measure(); refresh(); }).observe(spread);
      if (!root.classList.contains('motto-motion')) return;
      // Reduced motion switched on while the page is open: the CSS shows the
      // motto whole, and the hold goes too.
      const settle = () => { measure(); refresh(); };
      if (calm.addEventListener) calm.addEventListener('change', settle);

      const at = v => `${((v + .25) / 1.5 * 100).toFixed(2)}%`;
      // What the cut has opened of one character when the point is d em below
      // the head of its cell: a wedge behind the point, a slit at the point
      // and wider above it. The ink box reaches .25 em past the cell.
      const wedge = d => {
        if (d <= .06) return 'polygon(50% 0,50% 0,50% 0)';
        const foot = Math.min(d, 1.25), top = Math.min(.75, SLIT / 2 + WAKE * (d + .25)), low = Math.min(.75, SLIT / 2 + WAKE * (d - foot));
        if (low >= .75) return 'none';
        const points = [[.5 - top, -.25], [.5 + top, -.25]];
        if (top >= .75) { const y = d - (.75 - SLIT / 2) / WAKE; points.push([1.25, y], [.5 + low, foot], [.5 - low, foot], [-.25, y]); }
        else points.push([.5 + low, foot], [.5 - low, foot]);
        return `polygon(${points.map(([x, y]) => `${at(x)} ${at(y)}`).join(',')})`;
      };
      // d: where the point is, in em. The sword is unseen at rest and comes
      // in with the first scroll. As its point leaves 兵, the black iron
      // turns red (the sword becomes qi), then that red and the qi round it
      // fade, and at END the sword is gone. At rest it is already painted,
      // too faint to see, so the first stroke does not wait for its first
      // paint; at the end it stays painted the same way, for the way back.
      const draw = d => {
        if (d === drawn) return;
        drawn = d;
        blade.style.transform = `translate3d(0,${((d - LENGTH) * em).toFixed(1)}px,0)`;
        blade.style.opacity = d >= END ? .002 : Math.max(.002, ramp(d, START, START + .4));
        iron.style.opacity = Math.max(.002, 1 - ramp(d, 4.8, 5.05));
        glow.style.opacity = Math.max(.002, Math.min(ramp(d, 4.8, 5), 1 - ramp(d, 5.05, 5.4)) * .9);
        const air = String(Math.max(.002, 1 - ramp(d, 5.1, END)));
        qi.forEach(layer => { layer.style.opacity = air; });
        inks.forEach((ink, i) => { ink.style.clipPath = d >= END ? 'none' : wedge(d - i); });
        first.style.opacity = ramp(d, 2.3, 2.8);
        second.style.opacity = ramp(d, 5, 5.5);
      };
      // The point is a straight function of the scroll, drawn in the frame
      // the scroll is drawn in: no easing, no catching up. Once the page has
      // cut by itself, the motto stays open.
      const point = () => played ? END : START + (END - START) * clamp(scrollY / range);
      const follow = () => {
        if (!armed || timed || raf) return;
        raf = requestAnimationFrame(() => { raf = 0; if (!timed) draw(point()); });
      };
      // A page too short to scroll cuts once by itself when the motto is
      // seen, and the motto then stays open, also if the page becomes
      // scrollable mid-cut.
      let playing = false;
      const play = () => {
        if (played) return;
        played = playing = true;
        const begin = performance.now();
        const step = now => {
          if (!timed) { playing = false; return; }
          const t = clamp((now - begin) / 2400);
          draw(START + (END - START) * (t < .5 ? 2 * t * t : 1 - (2 - 2 * t) ** 2 / 2));
          if (t < 1) requestAnimationFrame(step); else playing = false;
        };
        requestAnimationFrame(step);
      };
      let seen = null;
      refresh = () => {
        if (!armed) return;
        if (!timed) {
          if (seen) { seen.disconnect(); seen = null; }
          return draw(point());
        }
        if (played) { if (!playing) draw(END); return; }
        draw(START);
        if (seen) return;
        if (!('IntersectionObserver' in window)) return play();
        seen = new IntersectionObserver(entries => { if (entries.some(entry => entry.intersectionRatio >= .35)) { seen.disconnect(); seen = null; play(); } }, { threshold: [0, .35] });
        seen.observe(motto);
      };
      const still = () => {
        armed = false;
        motto.classList.remove('is-armed');
        root.classList.remove('motto-motion');
        page.classList.remove('is-held');
        page.style.removeProperty('--hold');
        hold = 0;
      };
      // Never cut an empty column: wait for the brush face (its block period
      // is about 3 s); if it does not come, show the motto without motion.
      // Once the face is here the script owns the motto and the CSS failsafe
      // stands down.
      const font = document.fonts && document.fonts.load ? document.fonts.load('1em "Motto Brush"', '忘剑得神兵') : Promise.resolve([true]);
      Promise.race([font, new Promise(done => setTimeout(done, 2800, null))]).then(faces => {
        if (!faces || !faces.length) return still();
        try {
          armed = true;
          motto.classList.add('is-armed');
          measure();
          refresh();
          addEventListener('scroll', follow, { passive: true });
        } catch (error) { still(); }
      }, still);
    })();
  </script>
</Document>
<style>
  /* Zhi Mang Xing (SIL OFL 1.1), reduced to the five characters of the motto. */
  @font-face{font-family:'Motto Brush';src:url('/fonts/ZhiMangXing-Motto.woff2') format('woff2');font-display:block;unicode-range:U+5175,U+5251,U+5F97,U+5FD8,U+795E}
  /* One type scale, ratio 3 : 2 from the 16px body: 16 · 24 · 36 · 54–81 ·
     81–122 · 122–182. The heading moves between 54 and 81 with the viewport
     width, like the footer's 'Let's talk.'. The motto is two steps above the
     heading (2.25 ×) when the screen has room: its whole column fits below
     the heading's cap line, and the portrait beside it keeps a width of at
     least .45 of its height. With less room it is as large as the room
     allows, but not below one step above the heading (1.5 ×), which itself
     gives way only on screens too short for it. On phones the motto is the
     heading's size. Only the page label uses the site's 11px mono. --cap is
     the cap line of the heading, .116 em under the top of its box. */
  .about-page{--s-label:11px;--s-body:16px;--s-lead:24px;--s-head:36px;--s-display:clamp(54px,5.625vw,81px);--s-motto:calc(var(--s-display) * 1.5);--cap:calc(var(--s-display) * .116);--ink-deep:#2b2430;padding:0 var(--gutter);color:var(--ink)}
  @supports (height:100svh){.about-page{--s-motto:max(min(calc(var(--s-display) * 1.5),calc((100svh - 72px) / 4.775)),min(calc(var(--s-display) * 2.25),calc((100svh - 224px) / 4.775),calc((50vw - var(--gutter) - 12px) / 3.65)))}}
  :where(.about-page) :where(h1,h2,p,figure,ol){margin:0}
  .about-page a{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px}
  .about-page p a span,.about-research-link span{display:inline-block;text-decoration:none;margin-left:.25em}
  /* A link and its arrow stay on one line. */
  .about-introduction p a{white-space:nowrap}

  /* A spread of two pages. The words fill the left half, top to bottom. The
     right half holds the portrait and the motto, which stay in view while
     the words scroll past. Where the page is too short for the sword to go
     no faster than the scroll, the script holds the whole spread still for
     a while (--hold, at most half a screen) once its foot is on the screen;
     the space after the spread is the scroll of that hold. */
  .about-page:after{content:'';display:block;height:var(--hold,0px)}
  .about-page.is-held .about-spread{position:sticky;top:var(--hold-top,0px)}
  .about-spread{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;padding-block:40px 96px}
  .about-kicker{grid-column:1/7;grid-row:1;margin-bottom:32px;font:var(--s-label)/1.5 RFMono,monospace;letter-spacing:.02em}
  /* The negative indent puts the ink of "I" on the column line. */
  .about-spread h1{grid-column:1/7;grid-row:2;margin-left:-.025em;text-indent:-.05em;font-size:var(--s-display);font-weight:480;line-height:.94;letter-spacing:-.06em}
  .about-introduction{grid-column:1/7;grid-row:3;margin-top:48px;font-size:var(--s-body);line-height:1.6}
  .about-introduction>p{max-width:31em}
  .about-introduction>p:not(.about-role){text-wrap:pretty}
  .about-introduction>:global(*+*){margin-top:16px}
  .about-role{font-size:var(--s-lead);line-height:1.3;letter-spacing:-.025em;margin-bottom:24px;text-wrap:balance}
  /* The six links break into even rows (3 + 3, or 2 + 2 + 2), never 5 + 1. */
  .about-introduction :global(.profile-links){display:block;text-wrap:balance;font-size:var(--s-body);margin-top:20px}
  .about-introduction :global(.profile-links a:not(:last-child)){margin-right:20px}
  /* Without text-wrap: balance, a grid of three gives the same even rows. */
  @supports not (text-wrap:balance){
    .about-introduction :global(.profile-links){display:grid;grid-template-columns:repeat(3,max-content);column-gap:20px}
    .about-introduction :global(.profile-links a:not(:last-child)){margin-right:0}
  }
  @supports not (text-wrap:balance){@media(max-width:420px),(max-width:700px) and (max-height:504px){.about-introduction :global(.profile-links){grid-template-columns:repeat(2,max-content)}}}
  .about-research-link{display:inline-block;padding-block:10px}

  /* The right half: the portrait, then the motto on the right margin, like a
     painting and its inscription. Both start on the cap line of the heading,
     and the portrait is as tall as the motto's ink (4.775 em of its five
     cells). It fills the width it has, up to 5 : 4 on wide screens; a wide
     frame crops the photo from the bottom, so the head stays whole, and a
     narrow one keeps the helmet in the frame. The gap before the motto
     keeps the English at least 12px from the photo. */
  .about-rail{grid-column:7/-1;grid-row:2/6;padding-top:var(--cap)}
  .about-panel{position:sticky;top:36px;display:flex;justify-content:flex-end;height:calc(var(--s-motto) * 4.775)}
  .about-portrait{flex:0 1 calc(var(--s-motto) * 5.97);min-width:0;margin-right:max(calc(var(--s-motto) * .5),calc(var(--s-motto) * .1 + 32px));position:relative}
  .about-portrait>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:68% 0%;filter:saturate(.84)}
  .about-portrait:after{content:'';position:absolute;inset:0;background:var(--ink);mix-blend-mode:lighten;pointer-events:none}
  @media(forced-colors:active){.about-portrait:after{display:none}}
  .about-track{flex:none}

  /* The motto: five 1 em cells in one column, as on squared calligraphy
     paper. The brush ink starts .054 em into a cell and ends .829 em into
     it, so the column is set .054 em high. The brush face covers only the
     five characters, so the line strut comes from the site's Archivo. A Kai
     face stands in if the brush face cannot load. */
  .motto{position:relative;width:1em;margin-top:-.054em;font-size:var(--s-motto)}
  /* Screen readers hear the motto once, as one phrase; the five cells are
     only for the eye. */
  .motto__phrase{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .motto__text{font-family:'Motto Brush',RFArchivo,Arial,KaiTi,STKaiti,'Kaiti SC',serif;color:var(--ink-deep)}
  .motto__cell{position:relative;display:block;width:1em;height:1em;line-height:1;text-align:center}
  /* The ink box reaches .25 em past the cell, for strokes that leave it. */
  .motto__ink{position:absolute;inset:-.25em;padding:.25em}
  /* The translation stands beside the motto, where a calligrapher signs:
     each half of the English beside its half of the Chinese, 忘剑 and
     得神兵, closed by a seal. */
  .motto__translation{position:absolute;top:0;bottom:0;right:100%;width:calc(var(--s-motto) * .5);font:var(--s-body)/1.25 RFArchivo,Arial,sans-serif;letter-spacing:-.005em}
  .motto__translation span{position:absolute;top:calc(var(--s-motto) * .054);right:calc(var(--s-motto) * .1);writing-mode:vertical-rl;white-space:nowrap}
  /* On a short screen the second half starts no sooner than 16px after the
     first one ends (8.6 em of the 16px text). */
  .motto__translation span:last-child{top:max(calc(var(--s-motto) * 2.054),calc(var(--s-motto) * .054 + 8.6em))}
  .motto__translation span:last-child:after{content:'';display:inline-block;inline-size:14px;block-size:14px;margin-inline-start:12px;vertical-align:-1px;background:var(--clay);box-shadow:inset 0 0 0 2px var(--clay),inset 0 0 0 3px var(--ground)}

  /* The sword: black iron, 3.3 em from the handle to the point, wrapped in
     red qi (one painted layer behind the iron, one in front). It comes out
     of the head of the column and cuts down through it; past 兵 its point
     goes into the fade at the foot of its box, which ends 80px below 兵 at
     most, so it never reaches the footer, while the iron and then the qi
     fade out. It is seen only while the motto is cut. */
  .motto__blade{display:none;position:absolute;top:0;left:50%;width:.84em;height:min(5.8em,calc(4.829em + 80px));margin-left:-.42em;overflow:hidden;pointer-events:none;-webkit-mask-image:linear-gradient(#0000,#000 .45em,#000 calc(100% - .4em),#0000);mask-image:linear-gradient(#0000,#000 .45em,#000 calc(100% - .4em),#0000)}
  .motto__blade>span{position:absolute;top:0;left:0;right:0;height:3.3em;transform:translateY(-3.3em)}
  .motto__blade :global(svg),.motto__qi{position:absolute;inset:0;display:block;width:100%;height:100%}
  /* Each layer of the sword fades on its own, without being painted again;
     the red glow is painted once, too faint to see, until the sword goes. */
  .motto__blade :global(svg),.motto__qi{will-change:opacity}
  .motto__blade :global(.sword-ember){opacity:.002}
  .motto__qi{background:0 0/100% 100% no-repeat}
  .motto__qi--back{background-image:url('/images/motto-qi-back.webp')}
  .motto__qi--front{background-image:url('/images/motto-qi-front.webp')}
  @media(forced-colors:active){.motto__blade>span{forced-color-adjust:none}}
  /* Before the cut, each character shows only as a faint red print of
     itself, like the red characters of a calligraphy copybook that the ink
     then goes over. If the script never takes the motto over, the ink comes
     by itself after 4 s. Print and reduced motion show the motto whole,
     also when reduced motion is switched on while the page is open. */
  @media screen and (prefers-reduced-motion:no-preference){
    :global(.motto-motion) .motto__cell:before{content:attr(data-c);content:attr(data-c) / '';position:absolute;inset:0;color:var(--clay);opacity:.32}
    :global(.motto-motion) .motto:not(.is-armed) .motto__ink{clip-path:polygon(50% 0,50% 0,50% 0);animation:motto-failsafe 0s 4s forwards}
    :global(.motto-motion) .motto:not(.is-armed) .motto__translation span{opacity:0;animation:motto-failsafe 0s 4s forwards}
