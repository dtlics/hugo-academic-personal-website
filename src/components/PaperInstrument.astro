---
import { localPath } from '../lib/paths';
import StaticModel from './StaticModel.astro';
import '../styles/instrument-forms.css';
interface Props { kind: 'route' | 'measurement'; }
const { kind } = Astro.props;
const isRoute = kind === 'route';
---
<section class="instrument paper-instrument" data-paper-instrument={kind} data-asset-base={localPath('instruments/')} aria-labelledby={`instrument-${kind}-heading`}>
  <div class="paper-instrument__heading"><span class="paper-section-label">An exact example</span><h2 id={`instrument-${kind}-heading`}>{isRoute ? <>Routes, gates <br />and phase.</> : <>A measure you <br />can inspect.</>}</h2><p>{isRoute ? 'Inspect one compiled 4 × 4 circuit. Change the destinations, occupation and moment to see the corresponding exact state.' : 'Compare six noiseless projective measurement bases on one qubit. Change a basis and inspect each pair’s mutual eigenspace disturbance.'}</p></div>
  <div class="paper-instrument__preview"><StaticModel kind={kind} /></div>
  <div class="paper-instrument__launch"><button type="button" hidden data-load-instrument aria-expanded="false" aria-controls={`instrument-${kind}-mount`}>{isRoute ? 'Explore the exact circuit' : 'Explore the measurement atlas'} <span aria-hidden="true">↓</span></button><p role="status" data-instrument-status></p><noscript><p>The interactive example needs JavaScript. The diagram, paper, code and citation remain available.</p></noscript></div>
  <div class="instrument__mount" id={`instrument-${kind}-mount`} data-instrument-mount hidden></div>
  <div class="paper-instrument__scope"><span class="paper-section-label">Scope of this example</span><p>{isRoute ? 'This is the validated 4 × 4 compiler, with no ancillary qubits. It shows gates, stored bits, mode positions and relative phase. CNOT-equivalent depth and compiled moments are separate quantities.' : 'MED is not a probability. Opposite axes describe the same unordered basis. The complete-link groups in this atlas are illustrative; the paper used k-medoids. This example does not simulate the quantum switch.'}</p></div>
</section>
<script>
  import '../scripts/instruments';
</script>
